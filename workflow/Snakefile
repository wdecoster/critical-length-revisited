from snakemake.utils import min_version

min_version("8.0")


configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/resources.smk"
include: "rules/inventory.smk"
include: "rules/ladder.smk"
include: "rules/pilot.smk"


# Stage 1: data inventory, truth files, ladder steps 1-2
rule all:
    input:
        inventory_targets(),
        expand(os.path.join(RES, "giab", "{path}"), path=TRUTH_FILES),
        expand(os.path.join(RES, "stratifications", "{strat}.bed.gz"), strat=STRATS),
        os.path.join(OUT, "ladder", "summary_steps1-2.tsv"),


rule inventory:
    input:
        inventory_targets(),


# Stage 2: the pilot (Arm A on the pilot chromosomes): snakemake pilot
rule pilot:
    input:
        os.path.join(OUT, "pilot", "summary.tsv"),


# Milestone 4: length distributions rescaled to a grid of N50 values (the N50 recommendation):
# snakemake pilot_distributions
rule pilot_distributions:
    input:
        os.path.join(OUT, "pilot", "distributions.tsv"),
